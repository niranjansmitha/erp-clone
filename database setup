CREATE DATABASE IF NOT EXISTS peopleone_user_db;
USE peopleone_user_db;

-- 1. Temporarily disable foreign key checks
SET FOREIGN_KEY_CHECKS = 0;

-- 2. Drop existing tables
DROP TABLE IF EXISTS employee_leave_balance;
DROP TABLE IF EXISTS leave_requests;
DROP TABLE IF EXISTS employee_document;
DROP TABLE IF EXISTS employee_address;
DROP TABLE IF EXISTS employee_finance;
DROP TABLE IF EXISTS employee_job_details;
DROP TABLE IF EXISTS employee_identity;
DROP TABLE IF EXISTS employee_biographical;
DROP TABLE IF EXISTS user_auth;
DROP TABLE IF EXISTS policy_documents;
DROP TABLE IF EXISTS announcements;
DROP TABLE IF EXISTS department;
DROP TABLE IF EXISTS poll_votes;
DROP TABLE IF EXISTS polls;
DROP TABLE IF EXISTS kudos;
DROP TABLE IF EXISTS badges;
DROP TABLE IF EXISTS employee;
DROP TABLE IF EXISTS office_location;
DROP TABLE IF EXISTS company;

-- 3. Re-enable foreign key checks (Crucial!)
SET FOREIGN_KEY_CHECKS = 1;


-- 2. Core Organizational Tables
CREATE TABLE company (
    id CHAR(36) PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    group_company VARCHAR(255)
);
CREATE TABLE office_location (
    id CHAR(36) PRIMARY KEY,
    name VARCHAR(255),
    area VARCHAR(255),
    city VARCHAR(100),
    state VARCHAR(100),
    country VARCHAR(100),
    pincode VARCHAR(20),
    timezone VARCHAR(50)
);
CREATE TABLE employee (
    id CHAR(36) PRIMARY KEY,
    company_id CHAR(36),
    system_email_id VARCHAR(255) UNIQUE NOT NULL,
    first_name VARCHAR(100) NOT NULL,
    last_name VARCHAR(100),
    role VARCHAR(50) DEFAULT 'USER',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (company_id) REFERENCES company(id)
);
CREATE TABLE department (
    id CHAR(36) PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    business_unit VARCHAR(255),
    head_employee_id CHAR(36) NULL,
    FOREIGN KEY (head_employee_id) REFERENCES employee(id)
);
-- 3. Employee Sub-Tables
CREATE TABLE employee_biographical (
    employee_id CHAR(36) PRIMARY KEY,
    date_of_birth DATE,
    nationality VARCHAR(100),
    religion VARCHAR(100),
    marital_status VARCHAR(50),
    blood_group VARCHAR(10),
    t_shirt_size VARCHAR(10),
    emergency_contact_name VARCHAR(255),
    emergency_contact_relation VARCHAR(100),
    emergency_contact_mobile VARCHAR(20),
    FOREIGN KEY (employee_id) REFERENCES employee(id) ON DELETE CASCADE
);
CREATE TABLE employee_identity (
    employee_id CHAR(36) PRIMARY KEY,
    aadhaar_number VARCHAR(12) UNIQUE,
    is_aadhaar_verified BOOLEAN DEFAULT FALSE,
    pan_number VARCHAR(10) UNIQUE,
    is_pan_verified BOOLEAN DEFAULT FALSE,
    passport_number VARCHAR(20) UNIQUE,
    driving_license_no VARCHAR(50),
    is_dl_verified BOOLEAN DEFAULT FALSE,
    FOREIGN KEY (employee_id) REFERENCES employee(id) ON DELETE CASCADE
);
CREATE TABLE employee_job_details (
    employee_id CHAR(36) PRIMARY KEY,
    department_id CHAR(36),
    manager_id CHAR(36),
    base_office_location_id CHAR(36),
    designation VARCHAR(255),
    date_of_joining DATE,
    probation_period_days INT,
    employee_type VARCHAR(50),
    employee_sub_type VARCHAR(50),
    FOREIGN KEY (employee_id) REFERENCES employee(id) ON DELETE CASCADE,
    FOREIGN KEY (department_id) REFERENCES department(id),
    FOREIGN KEY (manager_id) REFERENCES employee(id),
    FOREIGN KEY (base_office_location_id) REFERENCES office_location(id)
);
CREATE TABLE employee_finance (
    employee_id CHAR(36) PRIMARY KEY,
    account_number VARCHAR(50),
    bank_name VARCHAR(255),
    ifsc_code VARCHAR(20),
    iban_number VARCHAR(50),
    swift_code VARCHAR(20),
    tax_calculation_method VARCHAR(50),
    pf_number VARCHAR(50),
    uan_number VARCHAR(20),
    pran_number VARCHAR(20),
    FOREIGN KEY (employee_id) REFERENCES employee(id) ON DELETE CASCADE
);
CREATE TABLE employee_address (
    id CHAR(36) PRIMARY KEY,
    employee_id CHAR(36),
    address_type VARCHAR(20) CHECK (address_type IN ('CURRENT', 'PERMANENT')),
    flat_house_number VARCHAR(100),
    street_locality VARCHAR(255),
    landmark VARCHAR(255),
    city VARCHAR(100),
    state VARCHAR(100),
    country VARCHAR(100),
    pincode VARCHAR(20),
    FOREIGN KEY (employee_id) REFERENCES employee(id) ON DELETE CASCADE
);
CREATE TABLE employee_document (
    id CHAR(36) PRIMARY KEY,
    employee_id CHAR(36),
    document_category VARCHAR(50),
    document_type VARCHAR(100),
    file_url TEXT NOT NULL,
    uploaded_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (employee_id) REFERENCES employee(id) ON DELETE CASCADE
);
-- ==========================================
-- NEW MICROSERVICE TABLES (Auth & Comm)
-- ==========================================
CREATE TABLE user_auth (
    id CHAR(36) PRIMARY KEY,
    email VARCHAR(255) UNIQUE NOT NULL,
    password VARCHAR(255) NOT NULL,
    role VARCHAR(50) NOT NULL,
    employee_id CHAR(36) NOT NULL,
    FOREIGN KEY (employee_id) REFERENCES employee(id) ON DELETE CASCADE
);
CREATE TABLE announcements (
    id CHAR(36) PRIMARY KEY,
    title VARCHAR(255) NOT NULL,
    content TEXT NOT NULL,
    author_id CHAR(36) NOT NULL,
    target_department_id CHAR(36),
    target_employee_id CHAR(36),
    category VARCHAR(50) NOT NULL,
    priority VARCHAR(50) NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (author_id) REFERENCES employee(id) ON DELETE CASCADE,
    FOREIGN KEY (target_department_id) REFERENCES department(id) ON DELETE CASCADE,
    FOREIGN KEY (target_employee_id) REFERENCES employee(id) ON DELETE CASCADE
);
CREATE TABLE policy_documents (
    id CHAR(36) PRIMARY KEY,
    title VARCHAR(255) NOT NULL,
    description VARCHAR(5000),
    category VARCHAR(255),
    version VARCHAR(255),
    file_url VARCHAR(255),
    uploaded_by VARCHAR(255),
    effective_date DATE,
    expiry_date DATE,
    status VARCHAR(50),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);
CREATE TABLE leave_requests (
    id CHAR(36) PRIMARY KEY,
    employee_id CHAR(36) NOT NULL,
    manager_id CHAR(36) NOT NULL,
    leave_type VARCHAR(50) NOT NULL,
    start_date DATE NOT NULL,
    end_date DATE NOT NULL,
    reason VARCHAR(255),
    status VARCHAR(50) NOT NULL DEFAULT 'PENDING',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (employee_id) REFERENCES employee(id) ON DELETE CASCADE,
    FOREIGN KEY (manager_id) REFERENCES employee(id) ON DELETE CASCADE
);
CREATE TABLE employee_leave_balance (
    id CHAR(36) PRIMARY KEY,
    employee_id CHAR(36) NOT NULL,
    leave_type VARCHAR(50) NOT NULL,
    total_allotted INT NOT NULL DEFAULT 0,
    used_days INT NOT NULL DEFAULT 0,
    available_balance INT NOT NULL DEFAULT 0,
    year INT NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (employee_id) REFERENCES employee(id) ON DELETE CASCADE,
    UNIQUE KEY uk_employee_leave_year (employee_id, leave_type, year)
);

CREATE TABLE badges (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    employee_id VARCHAR(255) NOT NULL,
    badge_name VARCHAR(255) NOT NULL,
    description VARCHAR(255),
    awarded_on DATE
);

CREATE TABLE kudos (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    sender_id VARCHAR(255),
    receiver_id VARCHAR(255),
    title VARCHAR(255),
    message VARCHAR(1000)
);

CREATE TABLE polls (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    question VARCHAR(255) NOT NULL,
    option1 VARCHAR(255) NOT NULL,
    option2 VARCHAR(255) NOT NULL,
    option3 VARCHAR(255),
    option4 VARCHAR(255),
    active BOOLEAN DEFAULT TRUE
);

CREATE TABLE poll_votes (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    poll_id BIGINT,
    employee_id VARCHAR(255),
    selected_option VARCHAR(255)
);

